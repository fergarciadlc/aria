    {
      "id": "functions-content",
      "type": "text",
      "x": 410,
      "y": 560,
      "width": 500,
      "height": 150,
      "text": "# audio.py\nload_audio(path, target_sr) → tuple[np.ndarray, int]\nsave_audio(path, audio, sr, format)\nsum_stems(stems: list) → np.ndarray\n\n# mix.py\ncompute_mix(track, spec) → np.ndarray\ngenerate_all_mix_specs(n, codec) → list[MixSpec]\n\n# track.py\nget_stem_path(track, stem, source, codec) → Path\nget_available_codecs(track) → list[str]",
      "fontSize": 13,
      "fontFamily": 3,
      "strokeColor": "#1e1e1e"
    },
